---
layout: base.njk
title: Blog
description: All articles on men's laser hair removal in Riyadh.
---
<div class="max-w-4xl mx-auto px-4 py-16">
  <h1 class="text-4xl font-bold mb-2">Blog</h1>
  <p class="text-muted mb-12">All articles on men's laser hair removal in Riyadh.</p>
  <div class="space-y-8">
    {% for post in collections.posts | reverse %}
    <article class="border-b border-white/10 pb-8">
      <a href="{{ post.url }}">
        {% if post.data.category %}<span class="text-[11px] uppercase tracking-wider text-accent">{{ post.data.category }}</span>{% endif %}
        <h2 class="text-2xl font-bold mt-2 hover:text-accent">{{ post.data.title }}</h2>
        <p class="text-muted mt-2">{{ post.data.description }}</p>
        <p class="text-xs text-muted mt-3">{{ post.date | date }}</p>
      </a>
    </article>
    {% endfor %}
  </div>
</div>